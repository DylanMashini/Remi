DATABASE_URL="postgresql://memoryaid:memoryaid@localhost:5432/memoryaid"

# AI
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Voice (TTS + Scribe STT)
ELEVENLABS_API_KEY=""
# Optional. Defaults to "Bella" (premade). Free plan: premade voices only; Voice Library voices return 402.
ELEVENLABS_VOICE_ID=""

# Email (Resend). onboarding@resend.dev only delivers to your own Resend account email.
RESEND_API_KEY=""
EMAIL_FROM="Recall <onboarding@resend.dev>"
# e.g. http://<mac LAN IP>:3000 so email links open on the phone. Empty = request Host header.
APP_URL=""

# Vercel Blob (enrollment photos)
BLOB_READ_WRITE_TOKEN=""

PLACE="the ECoRE building at Penn State"

# Optional overrides
APP_TIME_ZONE="America/New_York"
ELEVENLABS_MODEL_ID=""
# Model for lines with audio tags like [laughs] or [whispers] (default eleven_v4_turbo; Flash ignores tags)
ELEVENLABS_EXPRESSIVE_MODEL_ID=""
ELEVENLABS_STT_MODEL=""
OPENAI_STT_MODEL=""
# Ask answers: audio + glasses frame go straight to the Realtime API (default gpt-realtime-2.1).
OPENAI_REALTIME_MODEL=""
# Transcription model the realtime session runs on the wearer's audio for the memory log.
OPENAI_REALTIME_TRANSCRIBE_MODEL=""
# Live conversation (phone connects straight to OpenAI with a client secret minted by /api/realtime/session).
# Voice of the conversation (alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar). Default marin.
OPENAI_REALTIME_VOICE=""
# 0.25 to 1.5; default 0.9 (a little slower for an older listener).
REALTIME_SPEECH_SPEED=""
# server_vad (default) or semantic_vad. server_vad waits REALTIME_SILENCE_MS of silence before answering;
# the API default is 500 ms, ours is 1500 so the wearer can pause mid-sentence without being cut off.
REALTIME_TURN_DETECTION=""
REALTIME_SILENCE_MS=""
REALTIME_VAD_THRESHOLD=""
REALTIME_PREFIX_MS=""
# semantic_vad only: low (default) | medium | high | auto
REALTIME_EAGERNESS=""
# "1" lets the wearer talk over the glasses. Off by default (open-ear speakers next to the mic echo).
REALTIME_BARGE_IN=""
